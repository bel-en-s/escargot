---
const links = [
  { label: "About", href: "#about" },
  { label: "Destination", href: "#destination" },
  { label: "Contact", href: "#contact", button: true },
];
---

<header class="site-header">
  <div class="site-header-line" />
  <div class="site-header-inner">
    <div class="site-header-brand">
      <a class="site-logo" href="/">
        <img src="/logo-amarilloestrella.png" alt="Escargot" />
      </a>
      <span class="site-wordmark">
        Escargot <em>Adventures</em>
      </span>
    </div>
    <nav class="site-nav" id="site-nav">
      <div class="site-nav-links">
        {links.map((link) => (
          <a
            href={link.href}
            class={link.button ? "site-nav-button" : undefined}
          >
            {link.label}
          </a>
        ))}
      </div>
      <div class="site-social">
        <a
          href="https://www.instagram.com/"
          target="_blank"
          rel="noopener"
          aria-label="Instagram"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            width="22"
            height="22"
          >
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
        <a href="mailto:info@escargot.com" aria-label="Email">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            width="22"
            height="22"
          >
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="M22 7l-10 6L2 7"></path>
          </svg>
        </a>
        <a href="tel:+598991234567" aria-label="Phone">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            width="22"
            height="22"
          >
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </a>
      </div>
    </nav>
    <button
      class="menu-toggle"
      type="button"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
  <div class="site-header-line" />
</header>

<script>
  import gsap from "gsap";

  const wordmark = document.querySelector(".site-wordmark");
  if (wordmark) {
    gsap.set(wordmark, { width: 0, opacity: 0 });
    let shown = false;

    const onScroll = () => {
      const shouldShow = window.scrollY > window.innerHeight * 0.8;
      if (shouldShow === shown) return;
      shown = shouldShow;

      if (shouldShow) {
        gsap.to(wordmark, {
          width: wordmark.scrollWidth,
          opacity: 1,
          duration: 0.9,
          ease: "power4.out",
        });
      } else {
        gsap.to(wordmark, {
          width: 0,
          opacity: 0,
          duration: 0.4,
          ease: "power3.in",
        });
      }
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  const header = document.querySelector(".site-header");
  const toggle = header?.querySelector(".menu-toggle");
  const nav = header?.querySelector(".site-nav");

  if (header && toggle) {
    const close = () => {
      header.classList.remove("is-open");
      toggle.classList.remove("is-open");
      toggle.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
    };

    toggle.addEventListener("click", () => {
      const open = header.classList.toggle("is-open");
      toggle.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      document.body.style.overflow = open ? "hidden" : "";
    });

    nav?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", close);
    });
  }

  const hero = document.querySelector("main");

  if (header && hero) {
    const lines = header.querySelectorAll(".site-header-line");
    const fgEls = header.querySelectorAll(
      ".site-nav-links a:not(.site-nav-button), .site-social a, .site-wordmark"
    );
    const burger = header.querySelectorAll(".menu-toggle span");

    let overHero = null;
    let initialized = false;

    const paintHeader = (isOverHero, animate) => {
      const dur = animate ? 0.45 : 0;
      const bg = isOverHero ? "rgba(255, 255, 255, 0)" : "#ffffff";
      const fg = isOverHero ? "#ffffff" : "#000000";

      gsap.to(header, { backgroundColor: bg, duration: dur, ease: "power2.inOut", overwrite: "auto" });
      gsap.to(lines, { backgroundColor: fg, duration: dur, ease: "power2.inOut", overwrite: "auto" });
      gsap.to(fgEls, { color: fg, duration: dur, ease: "power2.inOut", overwrite: "auto" });
      gsap.to(burger, { backgroundColor: fg, duration: dur, ease: "power2.inOut", overwrite: "auto" });
    };

    const updateHeader = () => {
      const menuOpen = header.classList.contains("is-open");
      const inHero = window.scrollY < hero.offsetHeight - header.offsetHeight;
      const next = inHero && !menuOpen;

      if (initialized && next === overHero) return;

      overHero = next;
      paintHeader(next, initialized);
      initialized = true;
    };

    window.addEventListener("scroll", updateHeader, { passive: true });

    const observer = new MutationObserver(updateHeader);
    observer.observe(header, { attributes: true, attributeFilter: ["class"] });

    updateHeader();
  }
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    width: 100%;
    background-color: #ffffff;
  }

  .site-header-line {
    width: 100%;
    height: 1px;
    background-color: #000000;
  }

  .site-header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: 2000px;
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
  }

  .site-header-brand {
    display: flex;
    align-items: center;
  }

  .site-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .site-logo img {
    width: auto;
    height: 2.25rem;
    object-fit: contain;
  }

  .site-wordmark {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    width: 0;
    opacity: 0;
    font-family: "Instrument Serif", serif;
    font-weight: 400;
    font-size: 2em;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #000000;
    will-change: width, opacity;
  }

  .site-wordmark em {
    font-style: italic;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }

  .site-nav-links {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }

  .site-nav-links a {
    font-family: "Playfair Display", serif;
    font-size: 1.15rem;
    font-weight: 400;
    line-height: 1;
    color: #000000;
    text-decoration: none;
  }

  .site-nav-links a.site-nav-button {
    font-family: "Instrument Serif", serif;
    font-size: 1.4rem;
    line-height: 1;
    color: #000000;
    background-color: #ffd700;
    padding: 0.5rem 1.5rem;
    border-radius: 5px;
  }

  .site-social {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .site-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #000000;
    text-decoration: none;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .menu-toggle span {
    display: block;
    width: 28px;
    height: 2px;
    background-color: #000000;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .menu-toggle.is-open span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .menu-toggle.is-open span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle.is-open span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  @media (max-width: 700px) {
    .site-header-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 0;
      padding: 0.75rem 1.5rem;
    }

    .site-header-brand {
      position: relative;
      z-index: 110;
      flex-direction: row;
      align-items: center;
      gap: 0.5rem;
    }

    .site-logo img {
      height: 1.75rem;
    }

    .site-wordmark {
      font-size: 1.5rem;
    }

    .menu-toggle {
      position: relative;
      z-index: 110;
      display: flex;
    }

    .site-nav {
      position: fixed;
      inset: 0;
      z-index: 90;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 3rem;
      background-color: #ffffff;
      transform: translateY(-100%);
      transition: transform 0.5s cubic-bezier(0.83, 0, 0.17, 1);
    }

    .site-header.is-open .site-nav {
      transform: translateY(0);
    }

    .site-nav-links {
      flex-direction: column;
      align-items: center;
      gap: 2.5rem;
    }

    .site-nav-links a {
      font-family: "Instrument Serif", serif;
      font-size: 2rem;
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.4s ease, transform 0.4s ease;
    }

    .site-header.is-open .site-nav-links a {
      opacity: 1;
      transform: translateY(0);
    }

    .site-header.is-open .site-nav-links a:nth-child(1) {
      transition-delay: 0.05s;
    }

    .site-header.is-open .site-nav-links a:nth-child(2) {
      transition-delay: 0.15s;
    }

    .site-header.is-open .site-nav-links a:nth-child(3) {
      transition-delay: 0.25s;
    }

    .site-nav-links a.site-nav-button {
      font-size: 1.6rem;
      padding: 0.5rem 2rem;
    }

    .site-social {
      gap: 2rem;
    }

    .site-social a {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.4s ease, transform 0.4s ease;
    }

    .site-header.is-open .site-social a {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 0.35s;
    }

    .site-social svg {
      width: 26px;
      height: 26px;
    }
  }
</style>
