---
const links = [
  { label: "About", href: "#about" },
  { label: "Destination", href: "#destination" },
  { label: "Contact", href: "#contact", button: true },
];
---

<header class="site-header">
  <div class="site-header-line" />
  <div class="site-header-inner">
    <div class="site-header-brand">
      <a class="site-logo" href="/">
        <img src="/logo.png" alt="Escargot" />
      </a>
      <span class="site-wordmark">
        Escargot <em>Adventures</em>
      </span>
    </div>
    <nav class="site-nav">
      {links.map((link) => (
        <a
          href={link.href}
          class={link.button ? "site-nav-button" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
  <div class="site-header-line" />
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    width: 100%;
    background-color: #ffffff;
    padding: 0.25rem 2rem;
  }

  .site-header-line {
    width: 100%;
    height: 1px;
    background-color: #000000;
  }

  .site-header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: 2000px;
    margin: 0 auto;
    padding: 0.75rem 0;
  }

  .site-header-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .site-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .site-logo img {
    width: auto;
    height: 2.25rem;
    object-fit: contain;
  }

  .site-wordmark {
    display: inline-block;
    white-space: nowrap;
    font-family: "Instrument Serif", serif;
    font-weight: 400;
    font-size: 1.4rem;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #000000;
  }

  .site-wordmark em {
    font-style: italic;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }

  .site-nav a {
    font-family: "Playfair Display", serif;
    font-size: 1.15rem;
    font-weight: 400;
    line-height: 1;
    color: #000000;
    text-decoration: none;
  }

  .site-nav a.site-nav-button {
    font-family: "Instrument Serif", serif;
    font-size: 1.4rem;
    line-height: 1;
    color: #000000;
    background-color: #ffd700;
    padding: 0.5rem 1.5rem;
    border-radius: 5px;
  }

  @media (max-width: 700px) {
    .site-header {
      padding: 1rem 1.5rem;
    }

    .site-header-inner {
      flex-direction: column;
      gap: 0.75rem;
    }

    .site-header-brand {
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
    }

    .site-logo img {
      height: 1.75rem;
    }

    .site-nav {
      gap: 1.5rem;
    }

    .site-nav a {
      font-size: 1rem;
    }

    .site-nav a.site-nav-button {
      font-size: 1.15rem;
      padding: 0.5rem 1.25rem;
    }
  }
</style>
