---
import Contact from "./Contact.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer-content" id="contact">
    <img
      class="site-footer-topo"
      src="/topographic.svg"
      alt=""
      aria-hidden="true"
    />

    <Contact />
  </div>

  <div class="site-footer-dev">
    <span>designed & developed by</span>
    <a
      href="https://www.divinodivino.com.ar/"
      target="_blank"
      rel="noopener"
      aria-label="Divino Divino"
    >
      <img src="/logo-dd.png" alt="Divino Divino" />
    </a>
  </div>
  <div>
    <img
      class="site-footer-star"
      src="/logo-full.png"
      alt=""
      aria-hidden="true"
    />
  </div>

  <div class="site-footer-copy">
    <p>&copy; {year} Escargot Adventures. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    width: 100%;
    background-color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* border-top: 1px solid #000000; */
  }

  .site-footer-content {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    width: 100%;
    padding: 6rem 2rem;
    text-align: center;
    /* background-color: #d4e2aadc; */
  }

  .site-footer-content::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 8rem;
    background: linear-gradient(to bottom, #ffffff, rgba(255, 255, 255, 0));
    z-index: 1;
    pointer-events: none;
  }

  .site-footer-topo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform: rotate(90deg);
    z-index: 0;
  }

  .site-footer-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 3rem 2rem 1rem;
    text-align: center;
  }

  .site-footer-logo {
    width: auto;
    height: 3rem;
    object-fit: contain;
  }

  .site-footer-text {
    font-family: "Instrument Serif", serif;
    font-size: 1.5rem;
    line-height: 1;
    color: #000000;
  }

  .site-footer-star {
    width: auto;
    height: 5rem;
    object-fit: contain;
    margin: 2rem 0 1rem;
  }

  .site-footer-dev {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 1rem;
    border-top: 1px solid #000000;
    background-color: #ffffff;
  }

  .site-footer-dev span {
    font-family: "Instrument Serif", serif;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    color: #000000;
  }

  .site-footer-dev img {
    display: block;
    height: 2.5rem;
    width: auto;
    object-fit: contain;
  }

  .site-footer-copy {
    width: 100%;
    padding: 1.5rem 2rem;
    text-align: center;
  }

  .site-footer-copy p {
    font-family: "Instrument Serif", serif;
    font-size: 1rem;
    color: #000000;
  }
</style>
